; Engine configuration file.
; Quests — HF Newbie Helper / Letters of Love on 6a data + slice-2 UI/net.

config_version=5

[application]

config/name="Lineage 2d"
config/description="2D multiplayer Lineage 2 High Five–inspired prototype. HF DataRegistry + Newbie Helper tutorial and Letters of Love."
config/version="0.7.0"
run/main_scene="res://scenes/bootstrap.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

